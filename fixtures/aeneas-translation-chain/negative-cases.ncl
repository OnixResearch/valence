let NonEmptyString = std.contract.from_predicate (fun value =>
  std.is_string value && std.string.length value > 0
) in
let MutationKind = std.contract.from_predicate (fun value =>
  std.is_string value && std.array.elem value [
    "errorful_extraction",
    "skip_borrowck",
    "target_drift",
    "profile_drift",
    "stale_source",
    "swapped_llbc",
    "stale_manifest",
    "cross_run_def_id",
    "durable_def_id",
    "manifest_opacity_drift",
    "manifest_failure_drift",
    "manifest_divergence_drift",
    "manifest_recursion_drift",
    "loop_parent_drift",
    "stale_generated_lean",
    "missing_trust_node",
    "theorem_mismatch",
    "adequacy_mismatch",
    "wrong_digest_domain",
    "artifact_role_alias",
    "unsupported_profile",
    "unsupported_stage_role",
    "missing_node_field",
    "duplicate_edge",
    "missing_edge",
    "dangling_edge",
    "cycle",
    "lean_role_promotion",
    "manifest_role_promotion",
    "missing_octet_verification",
    "vacuous_approval_drift",
    "undeclared_trust_input",
    "weakened_non_claims",
    "unsupported_non_claim",
    "tampered_artifact",
    "proof_card_mismatch",
    "provenance_mismatch",
  ]
) in
let Case = {
  case_id | NonEmptyString,
  mutation | MutationKind,
  expected_issue | NonEmptyString,
} in
[
  { case_id = "errorful-extraction", mutation = "errorful_extraction", expected_issue = "errorful_extraction" },
  { case_id = "borrow-check-bypass", mutation = "skip_borrowck", expected_issue = "borrow_check_skipped" },
  { case_id = "target-drift", mutation = "target_drift", expected_issue = "target_metadata_mismatch" },
  { case_id = "profile-drift", mutation = "profile_drift", expected_issue = "extraction_profile_mismatch" },
  { case_id = "stale-source", mutation = "stale_source", expected_issue = "artifact_digest_mismatch" },
  { case_id = "swapped-llbc", mutation = "swapped_llbc", expected_issue = "artifact_digest_mismatch" },
  { case_id = "stale-manifest", mutation = "stale_manifest", expected_issue = "artifact_digest_mismatch" },
  { case_id = "cross-run-def-id", mutation = "cross_run_def_id", expected_issue = "cross_run_def_id" },
  { case_id = "durable-def-id", mutation = "durable_def_id", expected_issue = "run_local_def_id_used_as_stable_identity" },
  { case_id = "manifest-opacity-drift", mutation = "manifest_opacity_drift", expected_issue = "observed_manifest_mismatch" },
  { case_id = "manifest-failure-drift", mutation = "manifest_failure_drift", expected_issue = "observed_manifest_mismatch" },
  { case_id = "manifest-divergence-drift", mutation = "manifest_divergence_drift", expected_issue = "observed_manifest_mismatch" },
  { case_id = "manifest-recursion-drift", mutation = "manifest_recursion_drift", expected_issue = "observed_manifest_mismatch" },
  { case_id = "loop-parent-drift", mutation = "loop_parent_drift", expected_issue = "loop_parent_identity_mismatch" },
  { case_id = "stale-generated-lean", mutation = "stale_generated_lean", expected_issue = "artifact_digest_mismatch" },
  { case_id = "missing-trust-node", mutation = "missing_trust_node", expected_issue = "required_stage_missing" },
  { case_id = "theorem-mismatch", mutation = "theorem_mismatch", expected_issue = "theorem_link_mismatch" },
  { case_id = "adequacy-mismatch", mutation = "adequacy_mismatch", expected_issue = "claim_artifact_mismatch" },
  { case_id = "wrong-digest-domain", mutation = "wrong_digest_domain", expected_issue = "digest_role_mismatch" },
  { case_id = "artifact-role-alias", mutation = "artifact_role_alias", expected_issue = "artifact_role_alias" },
  { case_id = "unsupported-profile", mutation = "unsupported_profile", expected_issue = "unsupported_profile" },
  { case_id = "unsupported-stage-role", mutation = "unsupported_stage_role", expected_issue = "parse_error" },
  { case_id = "missing-node-field", mutation = "missing_node_field", expected_issue = "parse_error" },
  { case_id = "duplicate-edge", mutation = "duplicate_edge", expected_issue = "duplicate_edge" },
  { case_id = "missing-edge", mutation = "missing_edge", expected_issue = "required_edge_missing" },
  { case_id = "dangling-edge", mutation = "dangling_edge", expected_issue = "dangling_edge" },
  { case_id = "cycle", mutation = "cycle", expected_issue = "cycle_detected" },
  { case_id = "lean-result-promotion", mutation = "lean_role_promotion", expected_issue = "role_promotion" },
  { case_id = "manifest-promotion", mutation = "manifest_role_promotion", expected_issue = "role_promotion" },
  { case_id = "missing-octet-verification", mutation = "missing_octet_verification", expected_issue = "octet_verification_missing" },
  { case_id = "vacuous-approval-drift", mutation = "vacuous_approval_drift", expected_issue = "theorem_approval_mismatch" },
  { case_id = "undeclared-trust-input", mutation = "undeclared_trust_input", expected_issue = "trust_closure_incomplete" },
  { case_id = "weakened-non-claims", mutation = "weakened_non_claims", expected_issue = "non_claim_boundary_weakened" },
  { case_id = "unsupported-non-claim", mutation = "unsupported_non_claim", expected_issue = "parse_error" },
  { case_id = "tampered-artifact", mutation = "tampered_artifact", expected_issue = "artifact_digest_mismatch" },
  { case_id = "proof-card-mismatch", mutation = "proof_card_mismatch", expected_issue = "proof_card_claim_mismatch" },
  { case_id = "provenance-mismatch", mutation = "provenance_mismatch", expected_issue = "provenance_receipt_mismatch" },
] | Array Case
